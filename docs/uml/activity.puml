@startuml activity
' Activity Diagram - Colors web application: login, then search / add / log out

|User|
start
:Open index.html;
:Enter username and password;
:Click "Do It";

|Browser (code.js)|
:doLogin(): build JSON {login, password};
:POST LAMPAPI/Login.php;

|Server (PHP)|
:Login.php: SELECT ID, firstName, lastName
FROM Users WHERE Login=? AND Password=?;
if (Matching row?) then (yes)
  :Return {id, firstName, lastName, error:""};
else (no)
  :Return {id:0, error:"No Records Found"};
endif

|Browser (code.js)|
if (id < 1?) then (yes)
  :Show "User/Password combination incorrect";
  stop
else (no)
  :saveCookie() (expires in 20 min);
  :Redirect to color.html;
endif

:readCookie() on page load;
if (userId found in cookie?) then (no)
  :Redirect to index.html;
  stop
else (yes)
endif

|User|
repeat
  :Choose an action;
  if (Log out?) then (yes)
    :Click "Log Out";
    |Browser (code.js)|
    :doLogout(): expire cookie;
    :Redirect to index.html;
    stop
  else (no)
  endif
  |User|
  if (Search or Add?) then (Search)
    :Enter search text, click "Search Color";
    |Browser (code.js)|
    :searchColor(): POST SearchColors.php
    {search, userId};
    |Server (PHP)|
    :SELECT Name FROM Colors
    WHERE Name LIKE %search% AND UserID=?;
    if (Rows found?) then (yes)
      :Return {results:[...], error:""};
    else (no)
      :Return {error:"No Records Found"} (no results field);
    endif
    |Browser (code.js)|
    :Show "Color(s) has been retrieved";
    :Render results into #colorList;
  else (Add)
    |User|
    :Enter color name, click "Add Color";
    |Browser (code.js)|
    :addColor(): POST AddColor.php
    {color, userId};
    |Server (PHP)|
    :INSERT INTO Colors (UserId, Name);
    :Return {error:""};
    |Browser (code.js)|
    :Show "Color has been added";
  endif
  |User|
repeat while (Keep working?) is (yes)
@enduml
