@startuml usecase
' Use Case Diagram - Colors web application (Labs 1-3)
skinparam packageStyle rectangle

actor User
actor "MySQL Database" as DB <<system>>

rectangle "Colors Web Application" {
  usecase "Log In" as UC_Login
  usecase "Search Colors" as UC_Search
  usecase "Add Color" as UC_Add
  usecase "Log Out" as UC_Logout
  usecase "Verify Session\n(read cookie)" as UC_Session
  usecase "Show Login Error" as UC_LoginErr
}

User --> UC_Login
User --> UC_Search
User --> UC_Add
User --> UC_Logout

UC_Search ..> UC_Session : <<include>>
UC_Add ..> UC_Session : <<include>>
UC_LoginErr ..> UC_Login : <<extend>>

UC_Login --> DB
UC_Search --> DB
UC_Add --> DB

legend bottom
  Log In: POST Login.php {login, password}; on success a 20-minute cookie stores firstName, lastName, userId.
  Search Colors: POST SearchColors.php {search, userId}; partial match (LIKE %search%) on the user's own colors.
  Add Color: POST AddColor.php {color, userId}.
  Verify Session: runs on color.html load; no userId in cookie -> redirect to index.html.
  No registration, edit, or delete features exist in the app.
end legend
@enduml
